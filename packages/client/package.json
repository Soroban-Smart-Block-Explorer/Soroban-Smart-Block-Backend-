{
  "name": "@soroban-explorer/client",
  "version": "1.1.0",
  "description": "Official TypeScript SDK for the Soroban Smart Block Explorer API: typed REST (every OpenAPI operation), realtime feeds and GraphQL subscriptions.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "api-surface.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "block-explorer",
    "client",
    "feed",
    "graphql",
    "openapi",
    "reputation",
    "sdk",
    "soroban",
    "stellar",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Soroban-Smart-Block-Explorer/Soroban-Smart-Block-Backend-.git",
    "directory": "packages/client"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false
}
