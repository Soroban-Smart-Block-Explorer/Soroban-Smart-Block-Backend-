  burnedAmount Decimal? @map("burned_amount") @db.Decimal(30, 7)
  stakerRewards Decimal? @map("staker_rewards") @db.Decimal(30, 7)
  insuranceFund Decimal? @map("insurance_fund") @db.Decimal(30, 7)
