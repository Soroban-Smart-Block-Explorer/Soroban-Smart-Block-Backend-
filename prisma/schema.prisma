// ============================================================================
// Fiat On/Off-Ramp Gateway (#fiat-ramp)
// ============================================================================

/// Universal KYC record — one per user, shared across all ramp providers.
model RampKycRecord {
  id                String    @id @default(cuid())
  userId            String    @unique
  /// tier1 = email+phone only ($0–$1k/day)
  /// tier2 = ID verification ($1k–$10k/day)
  /// tier3 = full KYC + source of funds ($10k+/day)
  tier              String    @default("tier1")
  /// pending | submitted | approved | rejected | expired
  status            String    @default("pending")
  documentType      String?
  documentCountry   String?
  livenessScore     Float?
  pepScreened       Boolean   @default(false)
  sanctionsScreened Boolean   @default(false)
  verifiedAt        DateTime?
  expiresAt         DateTime?
  /// Map of provider name → provider-side KYC session/customer ID
  providerKycIds    Json      @default("{}")
  dailyLimitUsd     Float     @default(1000)
  monthlyLimitUsd   Float     @default(10000)
  dailyUsedUsd      Float     @default(0)
  monthlyUsedUsd    Float     @default(0)
  usageResetAt      DateTime?
  jurisdiction      String?
  blocked           Boolean   @default(false)
  blockReason       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  orders RampOrder[]

  @@index([status])
  @@index([tier])
  @@index([jurisdiction])
  @@map("ramp_kyc_records")
}

/// Full lifecycle of a single fiat ↔ crypto ramp order.
model RampOrder {
  id              String    @id @default(cuid())
  userId          String
  kycId           String?
  /// buy | sell
  direction       String
  provider        String
  providerOrderId String?
  /// pending | processing | completed | failed | refunded | cancelled
  status          String    @default("pending")
  fiatAmount      Float
  fiatCurrency    String    @default("USD")
  cryptoAmount    Float?
  cryptoAsset     String
  walletAddress   String
  paymentMethod   String
  exchangeRate    Float?
  platformFeeUsd  Float     @default(0)
  providerFeeUsd  Float     @default(0)
  networkFeeUsd   Float     @default(0)
  totalCostUsd    Float     @default(0)
  txHash          String?
  refundAmount    Float?
  refundStatus    String?
  refundedAt      DateTime?
  userIp          String?
  userCountry     String?
  metadata        Json      @default("{}")
  completedAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  kyc    RampKycRecord? @relation(fields: [kycId], references: [id])
  events RampOrderEvent[]

  @@index([userId])
  @@index([status])
  @@index([provider])
  @@index([providerOrderId])
  @@index([direction])
  @@index([createdAt(sort: Desc)])
  @@index([userId, status])
  @@map("ramp_orders")
}

/// Immutable audit log — one row per order state change.
model RampOrderEvent {
  id          String   @id @default(cuid())
  orderId     String
  fromStatus  String?
  toStatus    String
  triggeredBy String   @default("system")
  payload     Json     @default("{}")
  createdAt   DateTime @default(now())

  order RampOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
  @@map("ramp_order_events")
}

/// Daily provider reconciliation run results.
model RampReconciliation {
  id               String    @id @default(cuid())
  provider         String
  /// YYYY-MM-DD
  periodDate       String
  /// pending | running | completed | failed
  status           String    @default("pending")
  ordersChecked    Int       @default(0)
  discrepancyCount Int       @default(0)
  discrepancies    Json      @default("[]")
  totalVolumeUsd   Float     @default(0)
  errorRate        Float     @default(0)
  runAt            DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([provider, periodDate])
  @@index([status])
  @@index([provider])
  @@map("ramp_reconciliations")
}

/// AML monitoring alert raised against a user or order.
model RampAmlFlag {
  id          String    @id @default(cuid())
  userId      String
  orderId     String?
  /// structuring | rapid_in_out | high_risk_jurisdiction | large_single | velocity
  flagType    String
  /// low | medium | high | critical
  severity    String    @default("medium")
  description String
  metadata    Json      @default("{}")
  resolved    Boolean   @default(false)
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([orderId])
  @@index([flagType])
  @@index([resolved])
  @@index([createdAt(sort: Desc)])
  @@map("ramp_aml_flags")
}

