model PropagationAnalysis {
  id String @map("id") @id @default(cuid())
  advisoryId String @map("advisory_id")
  vulnerableContract String @map("vulnerable_contract")
  directAffected String[] @map("direct_affected") // list of directly affected contract addresses
  affectedByDepth Json @map("affected_by_depth") // JSON map of depth -> string[] (e.g. { "1": ["addr1"], "2": ["addr2"] })
  totalValueAtRisk Decimal? @map("total_value_at_risk") @default(0)
  analysisDepth Int @map("analysis_depth") @default(5)
  analyzedAt DateTime @map("analyzed_at") @default(now())
  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at") @updatedAt

  advisory VulnerabilityAdvisory @relation(fields: [advisoryId], references: [id])

  @@index([advisoryId])
  @@index([vulnerableContract])
  @@map("_propagation_analysis")
}




