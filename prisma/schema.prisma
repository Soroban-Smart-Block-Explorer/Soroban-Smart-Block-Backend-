  affectedPackage String? @map("affected_package")
  affectedContracts String[] @map("affected_contracts") // list of affected contract addresses
  publishedAt DateTime @map("published_at") @default(now())
  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at") @updatedAt

  propagationAnalyses PropagationAnalysis[]

  @@index([severity])
