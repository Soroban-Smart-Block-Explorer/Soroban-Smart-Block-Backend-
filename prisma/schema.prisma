  sourceChain           String    @db.VarChar(50)
  destinationChain      String    @db.VarChar(50)
  asset                 String    @db.VarChar(50)
  amount                Decimal   @db.Decimal(30, 7)
  sender                String    @db.VarChar(100)
  recipient             String    @db.VarChar(100)
  protocol              String    @db.VarChar(50)
  status                String    @default("pending") @db.VarChar(20)
  confirmations         Int       @default(0)
  requiredConfirmations Int       @default(0)
  sourceTimestamp       DateTime?
  destinationTimestamp  DateTime?
  estimatedArrivalAt    DateTime?
  bridgeFee             Decimal?  @db.Decimal(20, 7)
  sourceTxUrl           String?
  destinationTxUrl      String?
  metadata              Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([protocol])
  @@index([sourceChain])
  @@index([destinationChain])
  @@index([status])
  @@index([sender])
  @@index([recipient])
  @@index([createdAt])
  @@map("bridge_transactions")
}

model BridgeAlert {
  id              String   @id @default(uuid())
  type            String   @db.VarChar(50)
  severity        String   @default("info") @db.VarChar(20)
  protocol        String?  @db.VarChar(50)
  chain           String?  @db.VarChar(50)
  address         String?  @db.VarChar(100)
  transactionHash String?  @db.VarChar(100)
  asset           String?  @db.VarChar(50)
  amount          Decimal? @db.Decimal(30, 7)
  message         String   @db.Text
  data            Json?
  acknowledged    Boolean  @default(false)
  triggeredAt     DateTime @default(now())

  @@index([type])
  @@index([severity])
  @@index([address])
  @@index([triggeredAt])
  @@map("bridge_alerts")
}

