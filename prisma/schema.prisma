// ── Natural Language Query Interface (#328) ───────────────────────────────────

enum QueryFeedback {
  helpful
  not_helpful
  incorrect
  partial
}

model NlQuery {
  id               String         @id @default(cuid())
  userId           String?
  query            String
  language         String?
  interpretedQuery Json?
  sql              String?
  apiEndpoint      String?
  resolved         Boolean        @default(false)
  responseTime     Int?
  tokensUsed       Int?
  feedback         QueryFeedback?
  createdAt        DateTime       @default(now())

  context      NlQueryContext?
  savedQueries SavedQuery[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("nl_queries")
}

model NlQueryContext {
  id               String   @id @default(cuid())
  queryId          String   @unique @map("query_id")
  query            NlQuery  @relation(fields: [queryId], references: [id])
  sessionId        String?  @map("session_id")
  previousQueries  Json?    @map("previous_queries")
  resolvedEntities Json?    @map("resolved_entities")
  activeFilters    Json?    @map("active_filters")
  contextWindow    Int      @default(5) @map("context_window")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("nl_query_contexts")
}

model NlSession {
  id        String   @id @default(cuid())
  userId    String?
  context   Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("nl_sessions")
}

model SavedQuery {
  id         String    @id @default(cuid())
  userId     String?
  name       String
  nlTemplate String    @map("nl_template")
  parameters Json?
  schedule   String?
  lastRun    DateTime? @map("last_run")
  nextRun    DateTime? @map("next_run")
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  queryId    String?   @map("query_id")
  query      NlQuery?  @relation(fields: [queryId], references: [id])

  @@index([userId])
  @@index([queryId])
  @@map("saved_queries")
}

model NlEmbedding {
  id          String   @id @default(cuid())
  query       String   @unique
  embedding   Bytes
  intent      String
  filters     Json?
  usageCount  Int      @default(0) @map("usage_count")
  successRate Float    @default(0) @map("success_rate")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("nl_embeddings")
}

model NlQueryTemplate {
  id          String   @id @default(cuid())
  userId      String?
  name        String
  description String?
