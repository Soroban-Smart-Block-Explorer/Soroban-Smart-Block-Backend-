// ─── Governance & DAO Framework (issue #567) ────────────────────────────────
// Design: docs/governance-framework.md
//
// GovernanceContract is the per-DAO configuration root. `governanceType`
// discriminates the voting model: 'token_based' (default, written by the
// indexer), 'quadratic', 'conviction', 'multisig'. Numeric on-chain amounts
// (token weights, vote totals, stakes) are stored as strings holding integer
// values (i128-safe), matching the indexer's addIntegerStrings arithmetic.

model GovernanceContract {
  id String @map("id") @id
  contractAddress String @map("contract_address") @unique
  governanceType String @map("governance_type")
  votingToken String? @map("voting_token")
  // Shared voting config
  quorumBps Int? @map("quorum_bps") // quorum as basis points of total supply
  votingPeriodLedgers Int? @map("voting_period_ledgers") // proposal voting window in ledgers
  proposalThreshold String? @map("proposal_threshold") // min token balance to create a proposal
  timelockDelaySecs Int? @map("timelock_delay_secs") // delay between passage and execution (null → service default 48h)
  guardian String? @map("guardian") // address allowed to cancel queued proposals
  categories String[] @map("categories") @default([]) // delegation categories (e.g. tech, treasury)
  // Quadratic voting config
  voiceCreditsPerRound Int? @map("voice_credits_per_round") // per-voter credit budget per round
  minTokenHolding String? @map("min_token_holding") // Sybil floor: min balance for a credit budget
  minReputationScore Float? @map("min_reputation_score") // optional reputation gate
  // Conviction voting config
  convictionHalfLifeLedgers Int? @map("conviction_half_life_ledgers") // decay half-life for conviction accrual
  convictionMaxRatioBps Int? @map("conviction_max_ratio_bps") // max fraction of pool one proposal can request
  // Multisig config
  multisigThreshold Int? @map("multisig_threshold") // M of the active GovernanceMultisigSigner set
  metadata Json? @map("metadata")
  updatedAt DateTime @map("updated_at") @updatedAt
  createdAt DateTime @map("created_at") @default(now())

  proposals   GovernanceProposal[]
  votes       GovernanceVote[]
  delegates   GovernanceDelegate[]
  delegations GovernanceDelegation[]
  signers     GovernanceMultisigSigner[]
  treasuries  TreasuryAccount[]
  @@map("_governance_contracts")
}

// Aggregate delegate leaderboard cache (one row per delegatee), maintained by
// the indexer and rebuilt from GovernanceDelegation edges.
model GovernanceDelegate {
  id String @map("id") @id @default(cuid())
  contractAddress String @map("contract_address")
  delegatee String @map("delegatee")
  delegatedVotes String? @map("delegated_votes") // integer string (i128-safe)
  delegators Int? @map("delegators") // count of active inbound delegations
  proposalsVoted Int? @map("proposals_voted")
  updatedAt DateTime @map("updated_at") @updatedAt
  createdAt DateTime @map("created_at") @default(now())

  contract GovernanceContract @relation(fields: [contractAddress], references: [contractAddress], onDelete: Cascade)

  @@unique([contractAddress, delegatee])
  @@map("_governance_delegates")
}

// Delegation edge (delegator → delegatee), optionally scoped to a category.
// Edges are never deleted: revocation sets revokedAt, and power resolution
// only follows edges where revokedAt IS NULL. History feeds analytics.
model GovernanceDelegation {
  id String @map("id") @id @default(cuid())
  contractAddress String @map("contract_address")
  delegator String @map("delegator")
  delegatee String @map("delegatee")
  category String @map("category") @default("all")
  transactionHash String? @map("transaction_hash")
  ledgerSequence Int? @map("ledger_sequence")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @map("created_at") @default(now())

  contract GovernanceContract @relation(fields: [contractAddress], references: [contractAddress], onDelete: Cascade)

  @@index([contractAddress, delegator])
  @@index([contractAddress, delegatee])
  @@index([revokedAt])
  @@map("_governance_delegations")
}

// Quadratic-voting voice credit budgets, per (contract, round, holder).
// Cost to cast N votes on one proposal = N² credits (debited by the service).
model GovernanceVoiceCredit {
  id String @map("id") @id @default(cuid())
  contractAddress String @map("contract_address")
  round Int @map("round")
  holder String @map("holder")
  budget Int @map("budget")
  spent Int @map("spent") @default(0)
  updatedAt DateTime @map("updated_at") @updatedAt
  createdAt DateTime @map("created_at") @default(now())

  @@unique([contractAddress, round, holder])
  @@index([contractAddress, holder])
  @@map("_governance_voice_credits")
}

// Multisig signer set with membership history (removedAt NULL = active).
model GovernanceMultisigSigner {
  id String @map("id") @id @default(cuid())
  contractAddress String @map("contract_address")
  signer String @map("signer")
  addedAt DateTime @map("added_at") @default(now())
  removedAt DateTime? @map("removed_at")
  transactionHash String? @map("transaction_hash")

  contract GovernanceContract @relation(fields: [contractAddress], references: [contractAddress], onDelete: Cascade)

  @@unique([contractAddress, signer])
  @@index([contractAddress, removedAt])
  @@map("_governance_multisig_signers")
}

model GovernanceProposal {
  id String @map("id") @id
  contractAddress String @map("contract_address")
  proposalId String @map("proposal_id") // on-chain proposal id (natural key with contractAddress)
  proposer String @map("proposer")
  title String @map("title")
  description String? @map("description")
  targets Json @map("targets")
  values Json? @map("values") // per-target amounts for fund transfers
  calldatas Json? @map("calldatas") // per-target base64 InvokeContractArgs
  votingModel String? @map("voting_model") // snapshot of contract.governanceType at creation
  template String? @map("template") // parameter_change | fund_transfer | contract_upgrade | text
  snapshotLedger Int? @map("snapshot_ledger") // ledger at which voting power is measured
  startBlock Int @map("start_block")
  endBlock Int @map("end_block")
  quorum String? @map("quorum") // integer string (i128-safe)
  status String @map("status") // draft|pending|active|queued|executing|executed|defeated|failed|cancelled|expired
  queuedAt DateTime? @map("queued_at")
  eta DateTime? @map("eta") // earliest execution time once queued
  cancelledBy String? @map("cancelled_by")
  executionKind String? @map("execution_kind") // onchain | none (text proposals)
  executedAt DateTime? @map("executed_at")
  executionTxHash String? @map("execution_tx_hash")
  votesFor String? @map("votes_for") // integer strings (i128-safe running totals)
  votesAgainst String? @map("votes_against")
  votesAbstain String? @map("votes_abstain")
  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at") @updatedAt

  contract GovernanceContract @relation(fields: [contractAddress], references: [contractAddress], onDelete: Cascade)
  votes    GovernanceVote[]

  @@unique([contractAddress, proposalId])
  @@index([status])
  @@index([proposer])
  @@map("_governance_proposals")
}

model GovernanceVote {
  id String @map("id") @id
  contractAddress String @map("contract_address")
  proposalId String @map("proposal_id") // on-chain proposal id (FK to proposal's natural key)
  voter String @map("voter")
  weight String? @map("weight") // integer string (i128-safe)
  support String? @map("support") // for | against | abstain | confirm | unknown
  reason String? @map("reason")
  voiceCredits Int? @map("voice_credits") // quadratic: credits spent (= votes²)
  stakeAmount String? @map("stake_amount") // conviction: currently staked tokens
  convictionAt String? @map("conviction_at") // conviction: accrued conviction at lastUpdateLedger
  lastUpdateLedger Int? @map("last_update_ledger") // conviction: ledger of last conviction update
  transactionHash String? @map("transaction_hash")
  ledgerSequence Int? @map("ledger_sequence")
  createdAt DateTime @map("created_at") @default(now())

  contract GovernanceContract @relation(fields: [contractAddress], references: [contractAddress], onDelete: Cascade)
  proposal GovernanceProposal @relation(fields: [contractAddress, proposalId], references: [contractAddress, proposalId], onDelete: Cascade)

  @@unique([contractAddress, proposalId, voter])
  @@index([proposalId])
  @@index([voter])
  @@map("_governance_votes")
}

