/// Per-block spot price snapshot for a DEX pool.
/// Written by pool-price-monitor every ~2.5 s. Enables TWAP computation
/// and cross-DEX deviation detection used by the arbitrage scanner.
model PoolPrice {
  id BigInt @map("id") @id @default(autoincrement())
  poolId String @map("pool_id")
  blockNumber BigInt @map("block_number")
  timestamp DateTime @map("timestamp")
  /// Token A reserve (raw integer units, stored as string to avoid JS BigInt overflow)
  reserveA Decimal @map("reserve_a") @db.Decimal(30, 0)
  /// Token B reserve
  reserveB Decimal @map("reserve_b") @db.Decimal(30, 0)
  /// Instantaneous spot price (reserveB / reserveA)
  spotPrice Float @map("spot_price")
  /// 1-minute TWAP
  twap1m Float? @map("twap1m")
  /// 5-minute TWAP
  twap5m Float? @map("twap5m")
  /// 1-hour TWAP
  twap1h Float? @map("twap1h")

  pool DexPool @relation(fields: [poolId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([poolId, blockNumber], name: "poolId_blockNumber")
  @@index([poolId, timestamp])
  @@index([timestamp])
  @@map("_pool_prices")
}

/// Individual fee emission detected on-chain and classified by fee-classifier.
/// One row per fee-bearing event. Aggregated hourly/daily into ProtocolRevenue.
model FeeEvent {
  id BigInt @map("id") @id @default(autoincrement())
  txHash String @map("tx_hash") @db.VarChar(64)
  contractAddress String @map("contract_address") @db.VarChar(56)
  /// Classified fee type: SWAP | WITHDRAWAL | PERFORMANCE | PROTOCOL |
  /// LIQUIDATION | INTEREST_SPREAD | FLASH_LOAN | REFERRAL | INSURANCE_CONTRIBUTION
  feeType String @map("fee_type") @db.VarChar(40)
  /// Where the fee goes: LP_REWARDS | TREASURY | BUYBACK_BURN | STAKER_REWARDS |
  /// INSURANCE_FUND | ECOSYSTEM_FUND | TEAM_VESTING
  destination String @map("destination") @db.VarChar(40)
  /// Fee amount (string to preserve precision)
  amount Decimal @map("amount") @db.Decimal(30, 7)
  /// Token symbol or contract address
  token String @map("token") @db.VarChar(56)
  /// USD equivalent at time of detection (nullable if price feed unavailable)
  usdValue Float? @map("usd_value")
  sender String? @map("sender") @db.VarChar(56)
  receiver String? @map("receiver") @db.VarChar(56)
  blockNumber BigInt @map("block_number")
  timestamp DateTime @map("timestamp")

  @@unique([txHash, feeType, destination], name: "feeEvent_unique")
  @@index([contractAddress, timestamp])
  @@index([feeType])
  @@index([timestamp])
  @@map("_fee_events")
}

/// Aggregated protocol revenue for a contract over a calendar bucket.
/// Written by fee-aggregator on HOUR / DAY / WEEK / MONTH schedules.
model ProtocolRevenue {
  id String @map("id") @id
  contractAddress String @map("contract_address") @db.VarChar(56)
  protocolName String? @map("protocol_name") @db.VarChar(120)
  /// Aggregation period: HOUR | DAY | WEEK | MONTH
  period String @map("period") @db.VarChar(10)
  /// Bucket start time (aligned to period boundary)
  timestamp DateTime @map("timestamp")
  totalFees Decimal @map("total_fees") @db.Decimal(30, 7)
  swapFees Decimal? @map("swap_fees") @db.Decimal(30, 7)
  withdrawFees Decimal? @map("withdraw_fees") @db.Decimal(30, 7)
  performanceFees Decimal? @map("performance_fees") @db.Decimal(30, 7)
  protocolFees Decimal? @map("protocol_fees") @db.Decimal(30, 7)
  liquidationFees Decimal? @map("liquidation_fees") @db.Decimal(30, 7)
  interestSpread Decimal? @map("interest_spread") @db.Decimal(30, 7)
  flashLoanFees Decimal? @map("flash_loan_fees") @db.Decimal(30, 7)
  referralFees Decimal? @map("referral_fees") @db.Decimal(30, 7)
  lpRewards Decimal? @map("lp_rewards") @db.Decimal(30, 7)
