generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Ledger {
  sequence Int @map("sequence") @id
  hash String @map("hash") @unique
  previousLedgerHash String? @map("previous_ledger_hash")
  closeTime DateTime @map("close_time")
  txCount Int @map("tx_count") @default(0)
  createdAt DateTime @map("created_at") @default(now())

  transactions Transaction[]
  events       Event[]

  @@index([sequence])
  @@index([closeTime])
  @@map("_ledgers")
}

model WasmUpgradeHistory {
  id String @map("id") @id
  contractAddress String @map("contract_address")
  previousHash String? @map("previous_hash")
  newHash String @map("new_hash")
  ledgerSequence Int @map("ledger_sequence")
  ledgerCloseTime DateTime @map("ledger_close_time")
  transactionHash String? @map("transaction_hash")
  createdAt DateTime @map("created_at") @default(now())

  upgrader String? @map("upgrader")
  upgraderAccountAgeLedgers Int? @map("upgrader_account_age_ledgers")
  changeClassification String? @map("change_classification")
  changeSummary String? @map("change_summary")
  diffStats Json? @map("diff_stats")
  criticalFnChanges String[] @map("critical_fn_changes")
  governanceType String? @map("governance_type")
  signerCount Int? @map("signer_count")
  threshold Int? @map("threshold")
  timelockSeconds Int? @map("timelock_seconds")
  daoProposalId String? @map("dao_proposal_id")
  decentralizationScore Int? @map("decentralization_score")
  suspiciousFlags String[] @map("suspicious_flags")
  isSuspicious Boolean @map("is_suspicious") @default(false)
  riskLevel String? @map("risk_level")

  contract Contract @relation(fields: [contractAddress], references: [address])

  @@index([contractAddress, ledgerSequence])
  @@index([ledgerSequence])
  @@index([isSuspicious])
  @@index([changeClassification])
  @@map("_wasm_upgrade_histories")
}

model Transaction {
  id String @map("id") @id
  hash String @map("hash") @unique
  ledgerSequence Int @map("ledger_sequence")
  ledgerCloseTime DateTime @map("ledger_close_time")
  sourceAccount String @map("source_account")
  contractAddress String? @map("contract_address")
  functionName String? @map("function_name")
  functionArgs Json? @map("function_args")
  rawXdr String @map("raw_xdr")
  status String @map("status")
  flashLoanAlert Boolean? @map("flash_loan_alert")
  humanReadable String? @map("human_readable")
  feeCharged String? @map("fee_charged")
  sorobanResources Json? @map("soroban_resources")
  failureReason String? @map("failure_reason")
  createdAt DateTime @map("created_at") @default(now())

  ledger   Ledger    @relation(fields: [ledgerSequence], references: [sequence])
  contract Contract? @relation(fields: [contractAddress], references: [address])
  events               Event[]
  signatureInspections SignatureInspection[]

  @@index([hash])
  @@index([ledgerSequence])
  @@index([sourceAccount])
  @@index([contractAddress])
  @@index([status])
  @@index([contractAddress, ledgerSequence, id])
  @@index([sourceAccount, ledgerSequence, id])
  @@index([status, ledgerSequence, id])
  @@index([ledgerSequence, id])
  @@index([ledgerCloseTime, id])
  @@map("_transactions")
}

model Event {
  id String @map("id") @id @default(cuid())
  transactionHash String @map("transaction_hash")
  contractAddress String @map("contract_address")
  eventType String @map("event_type")
  topicSymbol String? @map("topic_symbol")
  topics Json @map("topics")
  data Json @map("data")
  decoded Json? @map("decoded")
  ledgerSequence Int @map("ledger_sequence")
  ledgerCloseTime DateTime @map("ledger_close_time")
  compacted Boolean? @map("compacted")
  createdAt DateTime @map("created_at") @default(now())

  ledger      Ledger      @relation(fields: [ledgerSequence], references: [sequence])
  transaction Transaction @relation(fields: [transactionHash], references: [hash])
  contract    Contract    @relation(fields: [contractAddress], references: [address])

  @@index([transactionHash])
  @@index([contractAddress])
  @@index([eventType])
  @@index([topicSymbol])
  @@index([ledgerSequence])
  @@index([contractAddress, topicSymbol])
  @@index([contractAddress, ledgerSequence, id])
  @@index([contractAddress, eventType, ledgerSequence])
  @@index([ledgerSequence, id])
  @@map("_events")
}

model EventDefinition {
  id String @map("id") @id @default(cuid())
  contractAddress String @map("contract_address")
  topicSymbol String @map("topic_symbol")
  humanTemplate String @map("human_template")
  submittedBy String? @map("submitted_by")
  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at") @updatedAt

  @@unique([contractAddress, topicSymbol])
  @@index([contractAddress])
  @@map("_event_definitions")
}

model AuditCertificate {
  id String @map("id") @id @default(cuid())
  contractAddress String @map("contract_address")
  version Int @map("version") @default(1)
  status String @map("status") // "draft" | "published" | "superseded" | "revoked"
  generatedAt DateTime @map("generated_at")
  expiresAt DateTime? @map("expires_at")
  overallScore Int @map("overall_score")
  securityScore Int @map("security_score")
  governanceScore Int @map("governance_score")
  economicScore Int @map("economic_score")
  complianceScore Int @map("compliance_score")
  liquidityScore Int @map("liquidity_score")
  signatureAlgorithm String @map("signature_algorithm")
  signature String @map("signature")
  publicKey String @map("public_key")
  certificateHash String @map("certificate_hash")
  anchorTxHash String? @map("anchor_tx_hash")
  totalFindings Int @map("total_findings") @default(0)
  openFindings Int @map("open_findings") @default(0)
  criticalFindings Int @map("critical_findings") @default(0)
  highFindings Int @map("high_findings") @default(0)
  mediumFindings Int @map("medium_findings") @default(0)
  lowFindings Int @map("low_findings") @default(0)
  resolvedFindings Int @map("resolved_findings") @default(0)
  findings Json @map("findings")
  scores Json @map("scores")
  metadata Json? @map("metadata")
  createdAt DateTime @map("created_at") @default(now())

  auditFindings AuditFinding[]
  auditEvents   AuditEvent[]
  contract      Contract? @relation(fields: [contractAddress], references: [address])

  @@unique([contractAddress, version])
  @@index([contractAddress, status])
  @@index([overallScore(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("_audit_certificates")
}

model AuditFinding {
  id String @map("id") @id @default(cuid())
  certificateId String @map("certificate_id")
  category String @map("category")
  severity String @map("severity")
  title String @map("title")
  description String @map("description")
  detail String? @map("detail")
  recommendation String? @map("recommendation")
  status String @map("status")
  resolvedAt DateTime? @map("resolved_at")
  resolutionNote String? @map("resolution_note")
  cweId String? @map("cwe_id")
  cvssVector String? @map("cvss_vector")
  cvssScore Float? @map("cvss_score")
  txHash String? @map("tx_hash")
  createdAt DateTime @map("created_at") @default(now())

  certificate AuditCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([certificateId])
  @@index([severity, status])
  @@index([category])
  @@map("_audit_findings")
}

model AuditEvent {
  id String @map("id") @id @default(cuid())
  contractAddress String @map("contract_address")
  certificateId String? @map("certificate_id")
  eventType String @map("event_type")
  previousScore Int? @map("previous_score")
  newScore Int? @map("new_score")
  triggerSource String @map("trigger_source")
  details Json? @map("details")
  timestamp DateTime @map("timestamp")
  createdAt DateTime @map("created_at") @default(now())

  certificate AuditCertificate? @relation(fields: [certificateId], references: [id])

  @@index([contractAddress, timestamp(sort: Desc)])
  @@index([eventType])
  @@index([certificateId])
  @@map("_audit_events")
}

model Contract {
  id String @map("id") @id @default(cuid())
  address String @map("address") @unique
  name String? @map("name")
  description String? @map("description")
  abi Json? @map("abi")
  functionSignatures Json? @map("function_signatures")
  isToken Boolean @map("is_token") @default(false)
  tokenSymbol String? @map("token_symbol")
  tokenName String? @map("token_name")
  tokenDecimals Int? @map("token_decimals")
  wasmHash String? @map("wasm_hash")
  isVerified Boolean @map("is_verified") @default(false)

  verificationBadge String? @map("verification_badge") // gold | silver | bronze | null
  lastVerifiedAt DateTime? @map("last_verified_at")
  safetyScore Int? @map("safety_score")
  verifiedProperties Int @map("verified_properties") @default(0)
  totalProperties Int @map("total_properties") @default(0)
  vulnerabilities Json? @map("vulnerabilities")

  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at") @updatedAt

  transactions     Transaction[]
  events           Event[]
  wasmUpgrades     WasmUpgradeHistory[]
  verificationRuns VerificationRun[]
  auditCerts       AuditCertificate[]

  @@index([address])
  @@index([verificationBadge])
  @@index([safetyScore])
  @@index([createdAt])
  @@map("_contracts")
}

model VerificationRun {
  id String @map("id") @id @default(cuid())
  contractAddress String @map("contract_address")
  contract        Contract  @relation(fields: [contractAddress], references: [address])
  status String @map("status") @default("pending") // pending | running | completed | failed
  badge String? @map("badge") // gold | silver | bronze
  safetyScore Int? @map("safety_score")
  report Json? @map("report")
  startedAt DateTime @map("started_at") @default(now())
  completedAt DateTime? @map("completed_at")
  createdAt DateTime @map("created_at") @default(now())

  @@index([contractAddress])
  @@index([status])
  @@index([safetyScore])
  @@map("_verification_runs")
}

model SessionAuthorization {
  id String @map("id") @id @default(cuid())
  eventId String @map("event_id") @unique
  contractAddress String @map("contract_address")
  hotSigner String? @map("hot_signer")
  authorizationType String @map("authorization_type")
  startLedger Int @map("start_ledger")
  expiryLedger Int @map("expiry_ledger")
  allocatedBlocks Int @map("allocated_blocks")
  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at") @updatedAt

  @@index([contractAddress])
  @@index([expiryLedger])
  @@map("_session_authorizations")
}

model DexPool {
  id String @map("id") @id @default(cuid())
  poolAddress String @map("pool_address") @unique @default("")
  chain String @map("chain") @default("stellar")
  protocol String @map("protocol") @default("")
  poolType String @map("pool_type") @default("constant_product") // "constant_product" | "stable" | "concentrated"
  feeBps Int @map("fee_bps") @default(0) // fee in basis points

  // ── Fields required by pool-price-monitor, arbitrage-engine, arbitrage-scanner ──
  /// Human-readable DEX name (e.g. "StellarSwap", "Aquarius")
  dexName String @map("dex_name") @default("")
  /// On-chain contract address for the pool (unique per pool)
  contractAddress String @map("contract_address") @unique @default("") @db.VarChar(56)
  /// Fee tier as a fraction (e.g. 0.003 = 0.3%). Derived from feeBps when not set.
  feeTier Decimal? @map("fee_tier") @db.Decimal(10, 6)
  /// Total liquidity in the pool (USD value or raw token units depending on context)
  totalLiquidity Decimal? @map("total_liquidity") @db.Decimal(30, 7)
  /// Whether this pool is actively monitored
  isActive Boolean @map("is_active") @default(true)

  // Token A
  tokenA String @map("token_a") @default("")
  tokenASymbol String @map("token_a_symbol") @default("")
  tokenADecimals Int @map("token_a_decimals") @default(7)
  reserveA Decimal @map("reserve_a") @default(0) @db.Decimal(30, 7)

  // Token B
  tokenB String @map("token_b") @default("")
  tokenBSymbol String @map("token_b_symbol") @default("")
  tokenBDecimals Int @map("token_b_decimals") @default(7)
  reserveB Decimal @map("reserve_b") @default(0) @db.Decimal(30, 7)

  // Price data
  priceAUsd Float? @map("price_a_usd")
  priceBUsd Float? @map("price_b_usd")

  // Metrics
  tvlUsd Float? @map("tvl_usd")
  volume1hUsd Float? @map("volume1h_usd")
  volume24hUsd Float? @map("volume24h_usd")
  /// Alias for volume24hUsd used by the arbitrage API groupBy queries
  volume24h Decimal? @map("volume24h") @db.Decimal(30, 7)
  volume7dUsd Float? @map("volume7d_usd")
  volume30dUsd Float? @map("volume30d_usd")
  fees24hUsd Float? @map("fees24h_usd")
  aprPct Float? @map("apr_pct")
  ilRiskScore Float? @map("il_risk_score")

  lastSyncedAt DateTime? @map("last_synced_at")

  createdAt DateTime @map("created_at") @default(now())
  updatedAt DateTime @map("updated_at") @updatedAt

  // Relations
  priceDevA       PriceDeviation[] @relation("priceDevA")
  priceDevB       PriceDeviation[] @relation("priceDevB")
  buyPool         ArbitrageOpportunity[] @relation("buyPool")
  sellPool        ArbitrageOpportunity[] @relation("sellPool")
  poolPrices      PoolPrice[]

  @@index([poolAddress])
  @@index([protocol])
  @@index([tvlUsd(sort: Desc)])
  @@index([isActive])
  @@index([dexName])
  @@map("_dex_pools")
}

model VulnerabilityAdvisory {
