# Dependencies
node_modules/

# Build output
dist/
dist-esm/
build/
out/

# Environment secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime / temp
node/
*.bak
*.tmp
*.swp
*.swo
.DS_Store
Thumbs.db

# Test artifacts — compiled JS, maps, types and snapshots
tests/**/*.js
tests/**/*.js.map
tests/**/*.d.ts

# Test snapshots
*.snap
*.snap.new
**/__snapshots__/
**/snapshots/

# Auto-generated fuzzing regression fixtures (#921)
# Written to tests/fuzzing/regressions/ when a confirmed fuzz finding is
# persisted via fuzzContract({ persist: true }); reproduced on demand instead
# of being committed, so CI stays hermetic and the tree stays clean.
tests/fuzzing/regressions/*.test.ts

# Temporary files
*.tmp
*.orig
